# ==============================================================================
# InfraCtrl Root .gitignore
# ==============================================================================

# Scratch test files
test_*.py

# Zip archives
*.zip

# ------------------------------------------------------------------------------
# Python (Backend)
# ------------------------------------------------------------------------------
# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.tox/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Node.js (Frontend)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/

# Build outputs
.next/
out/
dist/
build/
.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Terraform
# ------------------------------------------------------------------------------
# Local terraform directory
.terraform/

# State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files
# We ignore all .tfvars as they may contain secrets
*.tfvars
# Except for example files
!*.tfvars.example

# Crash logs
crash.log

# Ignore override files as they are usually local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ------------------------------------------------------------------------------
# Secrets & Credentials
# ------------------------------------------------------------------------------
# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Cloud & Security
*.pem
*.key
secrets.yml
credentials.json
.aws/
.ssh/
trust-policy.json

# ------------------------------------------------------------------------------
# IDE & Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iws
*.iml
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ------------------------------------------------------------------------------
# Operating System
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
*.log
logs/
*.sql.log
