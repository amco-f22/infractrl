# ==============================================================================
# Backend Environment Variables
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file:  cp env.example .env
# 2. Replace values below with your actual configuration
# 3. NEVER commit the .env file to git
# ==============================================================================

# --- Database (REQUIRED) ---
# Get this from: Supabase → Settings → Database → Connection string → URI → Transaction Mode
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- GitHub Actions Integration (OPTIONAL) ---
# Required only for automated provisioning via CI/CD
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_OWNER=yourusername
GITHUB_REPO=infractl-simple

# --- Slack Notifications (OPTIONAL) ---
# Required only for Slack alerts on provisioning, expiry, and budget
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Budget Configuration ---
# Monthly budget limit per user (in USD). Alerts at 80% and blocks at 100%.
BUDGET_LIMIT_PER_USER=200
